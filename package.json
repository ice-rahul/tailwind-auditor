{
  "name": "tailwind-auditor",
  "version": "1.1.0",
  "description": "Audit a Tailwind CSS project to highlight best practices and over-inflated inline class lists",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "tailwind",
    "tailwindcss",
    "audit",
    "linter",
    "best-practices",
    "css"
  ],
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "lint": "eslint \"bin/**/*.js\" \"src/**/*.js\" \"test/**/*.js\"",
    "format": "prettier --write \"bin/**/*.js\" \"src/**/*.js\" \"test/**/*.js\"",
    "format:check": "prettier --check \"bin/**/*.js\" \"src/**/*.js\" \"test/**/*.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ice-rahul/tailwind-auditor.git"
  },
  "homepage": "https://rahuls-organization-8.gitbook.io/tailwindauditor",
  "author": "Rahul Agrawal",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ice-rahul/tailwind-auditor/issues"
  },
  "bin": {
    "tailwind-auditor": "bin/index.js"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "fast-glob": "^3.3.1",
    "ignore": "^5.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.9.0",
    "prettier": "^3.9.6"
  }
}
